# Copy this file to .env and set real values
PUBLIC_DOMAIN=myadguardzi.duckdns.org
DUCKDNS_SUBDOMAINS=myadguardzi
DUCKDNS_TOKEN=replace-with-your-duckdns-token
# NetBird VPN IP of the host VM (run `netbird status` or `ip -4 addr show wt0` on host).
# If unset or empty, ports bind to 127.0.0.1 for local/loopback safety.
NETBIRD_IP=100.x.y.z
ADGUARD_ADMIN_USER=admin
ADGUARD_ADMIN_PASSWORD=change-this-password
LETSENCRYPT_EMAIL=you@example.com
LETSENCRYPT_STAGING=false
ALLOW_SELF_SIGNED_FALLBACK=false
INSTALL_RENEW_TIMER=true
# If false, bootstrap uses `certbot-renew` container as fallback.
RENEW_TIMER_ONCALENDAR="*-*-* 03:17:00"
RENEW_TIMER_RANDOMIZED_DELAY=45m
